diff --git a/kernel/Kconfig b/kernel/Kconfig
index 88e22811..9b844f37 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -43,4 +43,23 @@ config KSU_X86_PATCH_SYSCALL_DISPATCHER
 	  Dynamically patch x64's hardened syscall dispatcher to support syscall hooks. This is a
 	  replacement for a kernel source code patch, and is useful for x86_64 LKM mode.
 
+config KSU_SAMSUNG_KDP
+	bool "Samsung KDP credential support"
+	depends on KSU && ARM64
+	default n
+	help
+	  Install credentials through Samsung KDP read-only credential and PGD
+	  interfaces.  A device without those helpers keeps the standard credential
+	  path instead of failing the module load.
+
+config KSU_SAMSUNG_DEFEX
+	bool "Samsung DEFEX synchronization"
+	depends on KSU && ARM64 && KPROBES
+	default n
+	help
+	  Synchronize DEFEX credential state and bypass enforcement for a current
+	  task already running as root in the KernelSU SELinux domain, and for the
+	  task that loaded this module (which is DEFEX-visible before it enters
+	  that domain).
+
 endmenu
diff --git a/kernel/compat/samsung_defex.c b/kernel/compat/samsung_defex.c
new file mode 100644
index 00000000..40b1c7a0
--- /dev/null
+++ b/kernel/compat/samsung_defex.c
@@ -0,0 +1,259 @@
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/kprobes.h>
+#include <linux/ptrace.h>
+#include <linux/sched.h>
+
+#include "arch.h"
+#include "compat/samsung_defex.h"
+#include "infra/symbol_resolver.h"
+#include "klog.h"
+#include "selinux/selinux.h"
+
+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+/* Id reported to DEFEX for tasks KSU has already rooted: DEFEX keeps its own
+ * credential copy and must not observe uid 0 there. 1 is never a valid
+ * application uid.
+ */
+#define KSU_SAMSUNG_DEFEX_HIDDEN_ID 1u
+
+typedef void (*defex_get_task_creds_t)(struct task_struct *task, unsigned int *uid, unsigned int *fsuid,
+                                       unsigned int *egid, unsigned short *cred_flags);
+typedef int (*defex_set_task_creds_t)(struct task_struct *task, unsigned int uid, unsigned int fsuid,
+                                      unsigned int egid, unsigned short cred_flags);
+
+static defex_get_task_creds_t defex_get_task_creds;
+static defex_set_task_creds_t defex_set_task_creds;
+static bool defex_enforce_hooked;
+static bool defex_user_exec_hooked;
+
+/* Set once by ksu_samsung_defex_init(). A device without DEFEX keeps the
+ * standard credential path instead of failing the whole module load.
+ */
+static bool defex_available;
+
+/*
+ * The task that loaded this module is DEFEX-visible before it ever enters the KSU domain -
+ * ksud insmods in its own domain, not in the one KSU hands out - so the uid/domain test
+ * below can never cover it and DEFEX could kill it mid-load.  Its identity is kept as
+ * pid + start_time rather than a task_struct pointer: the pointer would dangle once that
+ * task exits and could then name an unrelated task that reuses the memory.
+ */
+static struct {
+    pid_t pid;
+    u64 start_time;
+} defex_trusted_task;
+
+static bool defex_is_trusted(struct task_struct *task)
+{
+    return task && task_pid_nr(task) == defex_trusted_task.pid &&
+           task->start_time == defex_trusted_task.start_time;
+}
+
+/* True when the task being checked is one DEFEX must not act on. */
+static bool defex_must_not_enforce(struct task_struct *task)
+{
+    return defex_is_trusted(task) || (task == current && current_uid().val == 0 && is_ksu_domain());
+}
+
+/*
+ * The function a probe redirects to: it answers "no violation" to whatever called the probed
+ * hook without touching a single argument.  That is what makes it usable for
+ * task_defex_user_exec, whose signature Samsung does not document - clearing an argument
+ * there could hand the function a NULL it does not expect.
+ */
+static noinline int __nocfi samsung_defex_allow(void)
+{
+    return 0;
+}
+
+/*
+ * True when @fn already ignores its arguments and returns 0: the stock Samsung stub
+ * (paciasp; mov w0, wzr; ...) or the one DFRoot's module leaves behind (bti c; mov x0, #0;
+ * ret).  Probing one of those only adds a trap to every call.
+ */
+static bool defex_fn_is_noop(const void *fn)
+{
+    const u32 *insn = fn;
+
+    /* Decide on the first word before reading the next ones: the DFRoot stub this looks for is
+     * three instructions (12 bytes), but a shorter stub would make the third read land in the
+     * function after it (CERT ARR30-C: keep every access inside the object being examined). */
+    if (insn[0] == 0xD503245Fu) /* bti c; mov x0, #0; ret */
+        return insn[1] == 0xD2800000u && insn[2] == 0xD65F03C0u;
+
+    if (insn[0] == 0xD503233Fu) /* paciasp; mov w0, wzr; ... */
+        return insn[1] == 0x2A1F03E0u;
+
+    return false;
+}
+
+static int ksu_samsung_defex_pre_handler(struct kprobe *probe, struct pt_regs *regs)
+{
+    struct task_struct *task = (struct task_struct *)PT_REGS_PARM1(regs);
+
+    (void)probe;
+
+    /*
+     * Redirect the call instead of clearing its argument.  Clearing the task argument only
+     * works while the vendor's function happens to check it for NULL - a device that does not
+     * would dereference it and panic, and that is a guess about Samsung's code we cannot verify.
+     * Jumping to a function that answers "no violation" skips the check entirely, which is the
+     * same trick the user-exec probe below uses, and what diabl0w's DEFEX patch relies on
+     * (validated on a real device, where it replaces the function for every task).
+     */
+    if (defex_must_not_enforce(task)) {
+        instruction_pointer_set(regs, (unsigned long)samsung_defex_allow);
+        return 1;
+    }
+
+    return 0;
+}
+
+static int ksu_samsung_defex_user_exec_pre(struct kprobe *probe, struct pt_regs *regs)
+{
+    (void)probe;
+
+    /* An exec is always done by the current task, so there is no argument to read. */
+    if (defex_must_not_enforce(current)) {
+        instruction_pointer_set(regs, (unsigned long)samsung_defex_allow);
+        return 1;
+    }
+
+    return 0;
+}
+
+static struct kprobe defex_enforce_kprobe = {
+    .symbol_name = "task_defex_enforce",
+    .pre_handler = ksu_samsung_defex_pre_handler,
+};
+
+static struct kprobe defex_user_exec_kprobe = {
+    .symbol_name = "task_defex_user_exec",
+    .pre_handler = ksu_samsung_defex_user_exec_pre,
+};
+#endif
+
+int ksu_samsung_defex_init(void)
+{
+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+    void *enforce_fn;
+    void *user_exec_fn;
+    int ret;
+
+    /* Remember who loaded us: module init runs in that task's context. */
+    defex_trusted_task.pid = task_pid_nr(current);
+    defex_trusted_task.start_time = current->start_time;
+
+    /*
+     * Ask for the DEFEX-specific names first.  get_task_creds()/set_task_creds() are generic
+     * enough to exist on a non-Samsung kernel with a different prototype, and calling such a
+     * symbol through our typedef is a type mismatch the __nocfi wrappers cannot make right - they
+     * only skip the kCFI check.
+     */
+    if (!find_kernel_symbol_exact("task_defex_enforce") &&
+        !find_kernel_symbol_exact("task_defex_user_exec")) {
+        pr_info("Samsung DEFEX not present, credential synchronization disabled\n");
+        return 0;
+    }
+
+    defex_get_task_creds = (defex_get_task_creds_t)find_kernel_symbol_exact("get_task_creds");
+    defex_set_task_creds = (defex_set_task_creds_t)find_kernel_symbol_exact("set_task_creds");
+    if (!defex_get_task_creds || !defex_set_task_creds) {
+        pr_info("Samsung DEFEX credential helpers missing, credential synchronization disabled\n");
+        return 0;
+    }
+
+    /*
+     * Probe a hook only while it still does something: on a target that already treats it as
+     * inert (a stock stub, or the patch DFRoot's module leaves behind) a probe would only add
+     * a trap to every call.
+     */
+    enforce_fn = (void *)find_kernel_symbol_exact("task_defex_enforce");
+    if (!enforce_fn) {
+        pr_info("Samsung DEFEX enforce hook not present, not probing it\n");
+    } else if (defex_fn_is_noop(enforce_fn)) {
+        pr_info("Samsung DEFEX enforce hook is already inert, not probing it\n");
+    } else {
+        ret = register_kprobe(&defex_enforce_kprobe);
+        if (ret)
+            pr_warn("Samsung DEFEX enforce hook unavailable: %d, continuing without the bypass\n", ret);
+        else
+            defex_enforce_hooked = true;
+    }
+
+    user_exec_fn = (void *)find_kernel_symbol_exact("task_defex_user_exec");
+    if (!user_exec_fn) {
+        pr_info("Samsung DEFEX user-exec hook not present, not probing it\n");
+    } else if (defex_fn_is_noop(user_exec_fn)) {
+        pr_info("Samsung DEFEX user-exec hook is already inert, not probing it\n");
+    } else {
+        ret = register_kprobe(&defex_user_exec_kprobe);
+        if (ret)
+            pr_warn("Samsung DEFEX user-exec hook unavailable: %d\n", ret);
+        else
+            defex_user_exec_hooked = true;
+    }
+
+    defex_available = true;
+
+    pr_info("Samsung DEFEX credential synchronization and KSU-task bypass enabled\n");
+#endif
+    return 0;
+}
+
+void ksu_samsung_defex_exit(void)
+{
+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+    if (defex_user_exec_hooked) {
+        unregister_kprobe(&defex_user_exec_kprobe);
+        defex_user_exec_hooked = false;
+    }
+    if (defex_enforce_hooked) {
+        unregister_kprobe(&defex_enforce_kprobe);
+        defex_enforce_hooked = false;
+    }
+#endif
+}
+
+/* Both calls below go through an address resolved from kallsyms, so they carry __nocfi for the
+ * same reason the KDP helpers do: kCFI checks the type id at an indirect call site, and a
+ * helper whose signature differs by a word turns the call into a kernel panic instead of a
+ * failed call.  noinline keeps the module's LTO from folding this back into an instrumented
+ * caller, which would put the check back; this runs on every root escalation.
+ */
+void __nocfi noinline ksu_samsung_defex_sync_current(void)
+{
+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+    const struct cred *cred;
+    unsigned int report_uid;
+    unsigned int report_fsuid;
+    unsigned int report_egid;
+    unsigned short cred_flags;
+    int ret;
+
+    if (!READ_ONCE(defex_available))
+        return;
+
+    cred = current_cred();
+
+    /* Only cred_flags is consumed from DEFEX: the ids are recomputed from the
+     * live credential below, so the id out-parameters are scratch.
+     */
+    defex_get_task_creds(current, &report_uid, &report_fsuid, &report_egid, &cred_flags);
+
+    if (__kuid_val(cred->euid) == 0 && __kuid_val(cred->fsuid) == 0 && __kgid_val(cred->egid) == 0) {
+        report_uid = KSU_SAMSUNG_DEFEX_HIDDEN_ID;
+        report_fsuid = KSU_SAMSUNG_DEFEX_HIDDEN_ID;
+        report_egid = KSU_SAMSUNG_DEFEX_HIDDEN_ID;
+    } else {
+        report_uid = __kuid_val(cred->euid);
+        report_fsuid = __kuid_val(cred->fsuid);
+        report_egid = __kgid_val(cred->egid);
+    }
+
+    ret = defex_set_task_creds(current, report_uid, report_fsuid, report_egid, cred_flags);
+    if (ret)
+        pr_err("Samsung DEFEX credential synchronization failed: %d\n", ret);
+#endif
+}
diff --git a/kernel/compat/samsung_defex.h b/kernel/compat/samsung_defex.h
new file mode 100644
index 00000000..f635af65
--- /dev/null
+++ b/kernel/compat/samsung_defex.h
@@ -0,0 +1,8 @@
+#ifndef __KSU_SAMSUNG_DEFEX_H
+#define __KSU_SAMSUNG_DEFEX_H
+
+int ksu_samsung_defex_init(void);
+void ksu_samsung_defex_exit(void);
+void ksu_samsung_defex_sync_current(void);
+
+#endif
diff --git a/kernel/compat/samsung_kdp.c b/kernel/compat/samsung_kdp.c
new file mode 100644
index 00000000..586c4803
--- /dev/null
+++ b/kernel/compat/samsung_kdp.c
@@ -0,0 +1,341 @@
+#include <linux/completion.h>
+#include <linux/capability.h>
+#include <linux/cred.h>
+#include <linux/mutex.h>
+#include <linux/errno.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/sched/task.h>
+#include <linux/sched/user.h>
+#include <linux/user_namespace.h>
+#include <linux/version.h>
+#include <linux/workqueue.h>
+#include <linux/pid.h>
+
+#include "infra/symbol_resolver.h"
+#include "ksu_samsung_kdp.h"
+#include "klog.h"
+
+#ifdef CONFIG_KSU_SAMSUNG_KDP
+enum samsung_kdp_cred_command {
+    KSU_SAMSUNG_KDP_COPY_CREDS = 0,
+};
+
+typedef struct cred *(*prepare_ro_creds_t)(struct cred *cred, int command, u64 task);
+typedef void (*kdp_assign_pgd_t)(struct task_struct *task);
+typedef void (*kdp_usecount_inc_t)(struct cred *cred);
+typedef void (*kdp_set_cred_non_rcu_t)(struct cred *cred, int val);
+typedef void (*set_dumpable_t)(struct mm_struct *mm, int value);
+typedef void (*key_fsuid_changed_t)(struct cred *new_cred);
+typedef void (*key_fsgid_changed_t)(struct cred *new_cred);
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+typedef unsigned int (*kdp_usecount_sub_and_test_t)(int nr, struct cred *cred);
+#else
+typedef unsigned int (*kdp_usecount_dec_and_test_t)(struct cred *cred);
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+typedef __typeof__(&inc_rlimit_ucounts) inc_rlimit_ucounts_t;
+typedef __typeof__(&dec_rlimit_ucounts) dec_rlimit_ucounts_t;
+#endif
+
+struct samsung_kdp_commit_work {
+    struct work_struct work;
+    struct completion completion;
+    struct task_struct *target;
+    const struct cred *old_cred;
+    struct cred *rw_cred;
+    int result;
+};
+
+static prepare_ro_creds_t prepare_ro_creds_fn;
+static kdp_assign_pgd_t kdp_assign_pgd_fn;
+static kdp_usecount_inc_t kdp_usecount_inc_fn;
+static kdp_set_cred_non_rcu_t kdp_set_cred_non_rcu_fn;
+/* The rest of what commit_creds() does around the pointer swap.  Optional: a kernel without
+ * them keeps the KDP path and skips that part (see ksu_samsung_kdp_init()).
+ */
+static set_dumpable_t set_dumpable_fn;
+static key_fsuid_changed_t key_fsuid_changed_fn;
+static key_fsgid_changed_t key_fsgid_changed_fn;
+static int *suid_dumpable_ptr;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+static kdp_usecount_sub_and_test_t kdp_usecount_sub_and_test_fn;
+#else
+static kdp_usecount_dec_and_test_t kdp_usecount_dec_and_test_fn;
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+static inc_rlimit_ucounts_t inc_rlimit_ucounts_fn;
+static dec_rlimit_ucounts_t dec_rlimit_ucounts_fn;
+#endif
+
+/* Set once by ksu_samsung_kdp_init(). A device without the KDP helpers keeps
+ * the standard credential path instead of failing the whole module load.
+ */
+static bool kdp_available;
+
+/*
+ * The transition has to run in a workqueue callback (Samsung's prepare_ro_creds() and
+ * kdp_assign_pgd() may sleep) while the caller waits for it.  The work item therefore has to
+ * outlive the callback: a stack object would end with the caller's frame, which is exactly what
+ * complete() wakes up, so one static item plus this lock serialize the whole commit instead.
+ */
+static DEFINE_MUTEX(ksu_samsung_kdp_commit_lock);
+static struct samsung_kdp_commit_work ksu_samsung_kdp_commit_work;
+
+/*
+ * Resolve one of the KDP helpers.  The exact lookup goes first: the variant scan accepts any
+ * "<name>." / "<name>$" match, which can be a compiler fragment (.cold / .isra / .part) that
+ * is not a function entry.  It is only a fallback, for the case where the plain name is gone -
+ * an LTO-suffixed local, or a symbol that survives only as its .cfi_jt trampoline.
+ */
+static void *samsung_kdp_symbol(const char *name)
+{
+    void *addr = (void *)find_kernel_symbol_exact(name);
+
+    if (!addr)
+        addr = ksu_resolve_symbol_for_functable_hook(name);
+
+    return addr;
+}
+
+static void samsung_kdp_commit_done(struct samsung_kdp_commit_work *commit_work, int result)
+{
+    commit_work->result = result;
+    complete(&commit_work->completion);
+}
+
+static void __nocfi samsung_kdp_commit_worker(struct work_struct *work)
+{
+    struct samsung_kdp_commit_work *commit_work = container_of(work, struct samsung_kdp_commit_work, work);
+    struct task_struct *target = commit_work->target;
+    const struct cred *old_cred = commit_work->old_cred;
+    const struct cred *target_cred;
+    const struct cred *target_real_cred;
+    struct cred *ro_cred;
+    bool user_changed;
+
+    /* The callers (KSU allowlist and the escape paths) decide whether a task
+     * may gain root; this worker only performs the transition it was handed.
+     * Checking current_uid() here would be meaningless, as workqueue callbacks
+     * run in kernel threads.
+     */
+    target_cred = rcu_access_pointer(target->cred);
+    target_real_cred = rcu_access_pointer(target->real_cred);
+    if (target_cred != old_cred || target_real_cred != old_cred) {
+        samsung_kdp_commit_done(commit_work, -EBUSY);
+        return;
+    }
+
+    ro_cred = prepare_ro_creds_fn(commit_work->rw_cred, KSU_SAMSUNG_KDP_COPY_CREDS, (u64)target);
+    if (!ro_cred) {
+        samsung_kdp_commit_done(commit_work, -EIO);
+        return;
+    }
+
+    user_changed = ro_cred->user != old_cred->user;
+    if (user_changed) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+        inc_rlimit_ucounts_fn(ro_cred->ucounts, UCOUNT_RLIMIT_NPROC, 1);
+#else
+        atomic_inc(&ro_cred->user->processes);
+#endif
+    }
+
+    /*
+     * commit_creds() takes a second reference here - "we will require a ref for the subj creds
+     * too" - because the two slots below are released separately by exit_creds(), so one
+     * reference would be put twice.  On a KDP credential that reference has to come from
+     * Samsung's own counter, the one ksu_samsung_kdp_put_cred() decrements: taking it with the
+     * inline get_cred() would leave the two implementations disagreeing about one credential.
+     *
+     * get_cred() is not just the increment:
+     *
+     *     nonconst_cred->non_rcu = 0;
+     *     return get_new_cred(nonconst_cred);
+     *
+     * and that clear has to come first, exactly as it does there.  On Samsung both fields live in
+     * memory protected at EL2, so neither may be touched with a plain store: the clear goes
+     * through kdp_set_cred_non_rcu() and is skipped entirely when that symbol is absent (writing
+     * non_rcu directly is the same fault as the inline put_cred() this file exists to avoid).
+     */
+    if (kdp_set_cred_non_rcu_fn)
+        kdp_set_cred_non_rcu_fn(ro_cred, 0);
+    kdp_usecount_inc_fn(ro_cred);
+
+    /*
+     * The two blocks commit_creds() runs before it publishes the pointers, for the same reasons:
+     * without the dumpability change a task that just gained root stays dumpable, so a process
+     * of its old uid could ptrace or core-dump root memory; without the keyring update the
+     * thread keyring keeps the old fsuid/fsgid.  The capability test is the kernel's
+     * !cred_cap_issubset(old, new) reduced to cap_permitted - this path never changes user_ns.
+     */
+    if (old_cred->euid.val != ro_cred->euid.val || old_cred->egid.val != ro_cred->egid.val ||
+        old_cred->fsuid.val != ro_cred->fsuid.val || old_cred->fsgid.val != ro_cred->fsgid.val ||
+        !cap_issubset(old_cred->cap_permitted, ro_cred->cap_permitted)) {
+        if (target->mm && set_dumpable_fn && suid_dumpable_ptr)
+            set_dumpable_fn(target->mm, *suid_dumpable_ptr);
+        target->pdeath_signal = 0;
+        smp_wmb();
+    }
+    if (ro_cred->fsuid.val != old_cred->fsuid.val && key_fsuid_changed_fn)
+        key_fsuid_changed_fn(ro_cred);
+    if (ro_cred->fsgid.val != old_cred->fsgid.val && key_fsgid_changed_fn)
+        key_fsgid_changed_fn(ro_cred);
+
+    rcu_assign_pointer(target->real_cred, ro_cred);
+    rcu_assign_pointer(target->cred, ro_cred);
+    kdp_assign_pgd_fn(target);
+
+    if (user_changed) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+        dec_rlimit_ucounts_fn(old_cred->ucounts, UCOUNT_RLIMIT_NPROC, 1);
+#else
+        atomic_dec(&old_cred->user->processes);
+#endif
+    }
+
+    abort_creds(commit_work->rw_cred);
+    commit_work->rw_cred = NULL;
+    /* Two references to drop, exactly like the tail of commit_creds(): the task held this cred
+     * in both real_cred and cred.  Dropping it once would leak it.
+     */
+    ksu_put_cred(old_cred);
+    ksu_put_cred(old_cred);
+
+    pr_info("Samsung KDP task-scoped credential install pid=%d uid=%u euid=%u\n", task_pid_nr(target),
+            __kuid_val(ro_cred->uid), __kuid_val(ro_cred->euid));
+
+    samsung_kdp_commit_done(commit_work, 0);
+}
+#endif
+
+#ifdef CONFIG_KSU_SAMSUNG_KDP
+/* The call below goes through an address resolved from kallsyms: __nocfi skips the kCFI type
+ * check there, and noinline keeps the module's LTO from folding this back into an instrumented
+ * caller, which would put the check back.
+ */
+void __nocfi noinline ksu_samsung_kdp_put_cred(const struct cred *cred)
+{
+    struct cred *mutable_cred = (struct cred *)cred;
+
+    if (!READ_ONCE(kdp_available)) {
+        put_cred(cred);
+        return;
+    }
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+    if (mutable_cred && kdp_usecount_sub_and_test_fn(1, mutable_cred))
+#else
+    if (mutable_cred && kdp_usecount_dec_and_test_fn(mutable_cred))
+#endif
+        __put_cred(mutable_cred);
+}
+#endif
+
+int ksu_samsung_kdp_init(void)
+{
+#ifdef CONFIG_KSU_SAMSUNG_KDP
+    prepare_ro_creds_fn = (prepare_ro_creds_t)samsung_kdp_symbol("prepare_ro_creds");
+    kdp_assign_pgd_fn = (kdp_assign_pgd_t)samsung_kdp_symbol("kdp_assign_pgd");
+    if (!prepare_ro_creds_fn || !kdp_assign_pgd_fn) {
+        pr_info("Samsung KDP not present, using the standard credential path\n");
+        return 0;
+    }
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+    kdp_usecount_sub_and_test_fn = (kdp_usecount_sub_and_test_t)samsung_kdp_symbol("kdp_usecount_sub_and_test");
+    if (!kdp_usecount_sub_and_test_fn) {
+        pr_info("Samsung KDP not present, using the standard credential path\n");
+        return 0;
+    }
+#else
+    kdp_usecount_dec_and_test_fn = (kdp_usecount_dec_and_test_t)samsung_kdp_symbol("kdp_usecount_dec_and_test");
+    if (!kdp_usecount_dec_and_test_fn) {
+        pr_info("Samsung KDP not present, using the standard credential path\n");
+        return 0;
+    }
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+    inc_rlimit_ucounts_fn = (inc_rlimit_ucounts_t)samsung_kdp_symbol("inc_rlimit_ucounts");
+    dec_rlimit_ucounts_fn = (dec_rlimit_ucounts_t)samsung_kdp_symbol("dec_rlimit_ucounts");
+    if (!inc_rlimit_ucounts_fn || !dec_rlimit_ucounts_fn) {
+        pr_info("Samsung KDP not present, using the standard credential path\n");
+        return 0;
+    }
+#endif
+
+    /* The increment is required, and grouped with the decrement above: Samsung's <linux/cred.h>
+     * answers both fields together, and the worker below must be able to take the second
+     * reference through the same counter ksu_samsung_kdp_put_cred() decrements.
+     */
+    kdp_usecount_inc_fn = (kdp_usecount_inc_t)samsung_kdp_symbol("kdp_usecount_inc");
+    if (!kdp_usecount_inc_fn) {
+        pr_info("Samsung KDP not present, using the standard credential path\n");
+        return 0;
+    }
+
+    /* Optional, and only a lifetime hint: without it the second reference above is taken
+     * without clearing non_rcu, which is the pre-5.13 behaviour of that helper.
+     */
+    kdp_set_cred_non_rcu_fn = (kdp_set_cred_non_rcu_t)samsung_kdp_symbol("kdp_set_cred_non_rcu");
+    if (!kdp_set_cred_non_rcu_fn)
+        pr_warn("Samsung KDP: kdp_set_cred_non_rcu missing, the second cred reference skips the non_rcu clear\n");
+
+    /* Optional: the dumpability and thread-keyring fixups of commit_creds().  A kernel without
+     * them keeps the KDP path and skips that part of the commit rather than losing KDP - the
+     * plain credential path is the one that is not usable on new firmware.
+     */
+    set_dumpable_fn = (set_dumpable_t)samsung_kdp_symbol("set_dumpable");
+    suid_dumpable_ptr = (int *)samsung_kdp_symbol("suid_dumpable");
+    key_fsuid_changed_fn = (key_fsuid_changed_t)samsung_kdp_symbol("key_fsuid_changed");
+    key_fsgid_changed_fn = (key_fsgid_changed_t)samsung_kdp_symbol("key_fsgid_changed");
+    if (!set_dumpable_fn || !suid_dumpable_ptr || !key_fsuid_changed_fn || !key_fsgid_changed_fn)
+        pr_warn("Samsung KDP: dumpability/keyring helpers incomplete, that part of the commit is skipped\n");
+
+    kdp_available = true;
+    pr_info("Samsung KDP task-scoped credential and native PGD path enabled\n");
+#endif
+    return 0;
+}
+
+int ksu_samsung_kdp_commit_creds(struct cred *cred)
+{
+#ifdef CONFIG_KSU_SAMSUNG_KDP
+    struct samsung_kdp_commit_work *commit_work = &ksu_samsung_kdp_commit_work;
+    bool queued;
+    int ret;
+
+    if (!cred)
+        return -EINVAL;
+
+    if (!READ_ONCE(kdp_available))
+        return commit_creds(cred);
+
+    mutex_lock(&ksu_samsung_kdp_commit_lock);
+    INIT_WORK(&commit_work->work, samsung_kdp_commit_worker);
+    init_completion(&commit_work->completion);
+    commit_work->target = current;
+    commit_work->old_cred = current_real_cred();
+    commit_work->rw_cred = cred;
+    commit_work->result = -EIO;
+
+    get_task_struct(commit_work->target);
+    queued = schedule_work(&commit_work->work);
+    if (!queued) {
+        put_task_struct(commit_work->target);
+        mutex_unlock(&ksu_samsung_kdp_commit_lock);
+        return -EBUSY;
+    }
+
+    wait_for_completion(&commit_work->completion);
+    /* The pool bookkeeping in process_one_work() runs *after* the callback returns, so the
+     * complete() above does not mean the work item is done with.  flush_work() waits for that
+     * tail, which is what lets the next caller safely re-INIT this object. */
+    flush_work(&commit_work->work);
+    put_task_struct(commit_work->target);
+    ret = commit_work->result;
+    mutex_unlock(&ksu_samsung_kdp_commit_lock);
+    return ret;
+#else
+    return commit_creds(cred);
+#endif
+}
diff --git a/kernel/compat/samsung_rkp.c b/kernel/compat/samsung_rkp.c
new file mode 100644
index 00000000..618800d4
--- /dev/null
+++ b/kernel/compat/samsung_rkp.c
@@ -0,0 +1,551 @@
+/*
+ * Samsung RKP-aware function replacement.
+ *
+ * See include/ksu_samsung_rkp.h for why this exists.  The short version: on a target whose
+ * text and rodata are taken away at EL2, ksu_patch_text()'s fixmap write is refused, so a
+ * caller that wants a table entry to point somewhere else cannot write the entry.  This file
+ * writes the *function* instead - one B instruction at its entry - which the kernel's own
+ * text-patching path (aarch64_insn_patch_text(), the one kprobes use) does allow.
+ *
+ * A stub next to it keeps the original callable.  The stub has to be reached with a plain
+ * call: it lives in a page no module owns, so a CFI-checked indirect call to it would fail
+ * the check, and callers that reach it are marked __nocfi for that reason.
+ */
+
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/moduleloader.h>
+#include <linux/set_memory.h>
+#include <linux/types.h>
+#include <linux/version.h>
+#include <linux/vmalloc.h>
+
+#include "infra/symbol_resolver.h"
+#include "ksu_samsung_rkp.h"
+#include "klog.h"
+
+#ifdef __aarch64__
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+#include <linux/execmem.h>
+#define ksu_rkp_alloc(sz) execmem_alloc(EXECMEM_MODULE_TEXT, (sz))
+#define ksu_rkp_free(p) execmem_free(p)
+#else
+#define ksu_rkp_alloc(sz) module_alloc(sz)
+#define ksu_rkp_free(p) vfree(p)
+#endif
+
+#define KSU_RKP_MAX_SITES 16
+
+/*
+ * One stub is 16 bytes, entry at +4:
+ *   [0] the replaced function's kCFI type hash (it sits at fn-4).  Every caller here is
+ *       __nocfi so it is never consulted on this kernel; it is what would make the stub a
+ *       valid indirect target on a kernel that does check
+ *   [4] a landing pad: the PAC instruction that was at fn+0 when it was replaced, or BTI C
+ *   [8] the instruction the branch displaced, re-executed before returning to the function
+ *  [12] B back to the first instruction after the displaced one
+ */
+#define KSU_RKP_STUB_SIZE 16
+#define KSU_RKP_STUBS_PER_PAGE (PAGE_SIZE / KSU_RKP_STUB_SIZE)
+
+#define KSU_RKP_INSN_BTI_C 0xD503245Fu
+#define KSU_RKP_INSN_PACIASP 0xD503233Fu
+#define KSU_RKP_INSN_PACIBSP 0xD503237Fu
+#define KSU_RKP_INSN_B_OPC 0x14000000u
+
+typedef int (*ksu_rkp_insn_patch_t)(void *addrs[], u32 insns[], int cnt);
+
+struct ksu_rkp_site {
+    void *fn;
+    u32 insn_at_patch; /* what the branch displaced, put back on restore */
+    u32 insn_at_fn0;   /* the PAC instruction at fn+0 that was replaced, or 0 */
+    unsigned int stub_idx;
+    unsigned int preamble_skip;
+};
+
+static ksu_rkp_insn_patch_t ksu_rkp_insn_patch;
+static struct ksu_rkp_site ksu_rkp_sites[KSU_RKP_MAX_SITES];
+static unsigned int ksu_rkp_site_count;
+static DEFINE_MUTEX(ksu_rkp_site_lock);
+static void *ksu_rkp_stub_page;
+static unsigned int ksu_rkp_stub_next;
+/* Slots a restore handed back, reused only after a drain (see ksu_rkp_alloc_stub()). */
+static unsigned int ksu_rkp_stub_free[KSU_RKP_MAX_SITES];
+static unsigned int ksu_rkp_stub_free_count;
+/* synchronize_rcu_tasks() is not exported to modules, so it is resolved by name - the same
+ * reason susfs resolves it.  Without it no stub is recycled and the page is never freed.
+ */
+static void (*ksu_rkp_drain_callers)(void);
+static bool ksu_rkp_active;
+
+bool ksu_samsung_rkp_active(void)
+{
+    return READ_ONCE(ksu_rkp_active);
+}
+
+/* A B instruction, or 0 when @to is out of the +/-128 MB a B can reach. */
+static u32 ksu_rkp_encode_b(void *from, void *to)
+{
+    s64 delta = (s64)(unsigned long)to - (s64)(unsigned long)from;
+    s64 imm26 = delta >> 2;
+
+    if (delta & 0x3)
+        return 0;
+    if (imm26 < -(1LL << 25) || imm26 > (1LL << 25) - 1)
+        return 0;
+
+    return KSU_RKP_INSN_B_OPC | ((u32)imm26 & 0x3FFFFFFu);
+}
+
+static bool ksu_rkp_is_pac_signing(u32 insn)
+{
+    return insn == KSU_RKP_INSN_PACIASP || insn == KSU_RKP_INSN_PACIBSP;
+}
+
+/* BTI variants are bits[31:8] = 0xD50324 with an even op2 and bits[4:0] = 0x1F; the PAC
+ * instructions are landing pads too, which is why they are accepted here. */
+static bool ksu_rkp_is_landing_pad(u32 insn)
+{
+    return (insn & 0xFFFFFF3Fu) == 0xD503241Fu || ksu_rkp_is_pac_signing(insn);
+}
+
+/* An instruction whose meaning depends on the address it sits at cannot be moved into a
+ * stub: it would compute against the stub instead of the function. */
+static bool ksu_rkp_is_pc_relative(u32 insn)
+{
+    return ((insn & 0x1F000000u) == 0x10000000u) || /* ADR / ADRP        */
+           ((insn & 0x3B000000u) == 0x18000000u) || /* LDR literal       */
+           ((insn & 0x7C000000u) == 0x14000000u) || /* B / BL            */
+           ((insn & 0xFE000000u) == 0x54000000u) || /* B.cond / BC.cond  */
+           ((insn & 0x7E000000u) == 0x34000000u) || /* CBZ / CBNZ        */
+           ((insn & 0x7E000000u) == 0x36000000u);   /* TBZ / TBNZ        */
+}
+
+static struct ksu_rkp_site *ksu_rkp_find_site(void *fn)
+{
+    unsigned int i;
+
+    for (i = 0; i < ksu_rkp_site_count; i++) {
+        if (ksu_rkp_sites[i].fn == fn)
+            return &ksu_rkp_sites[i];
+    }
+
+    return NULL;
+}
+
+/*
+ * Put a site back exactly as it was found.  When fn+0 was replaced, both words go back in one
+ * patch - the same way they went in.  Restoring them separately would leave a window in which
+ * fn+0 is the original again while the branch is still there, and a caller that arrives then
+ * runs the function without its PAC sign and dies at the epilogue.
+ */
+static int ksu_rkp_restore_site(struct ksu_rkp_site *site)
+{
+    void *patch_addr = (u8 *)site->fn + site->preamble_skip * 4;
+    int ret;
+
+    if (site->insn_at_fn0) {
+        void *addrs[2] = { patch_addr, site->fn };
+        u32 insns[2] = { site->insn_at_patch, site->insn_at_fn0 };
+
+        ret = ksu_rkp_insn_patch(addrs, insns, 2);
+    } else {
+        u32 insn = site->insn_at_patch;
+
+        ret = ksu_rkp_insn_patch(&patch_addr, &insn, 1);
+    }
+
+    if (ret)
+        pr_err("ksu_samsung_rkp: restore at %pS failed: %d\n", site->fn, ret);
+
+    return ret;
+}
+
+/*
+ * Fill a stub.  The page is read-only and executable, so the words go in through the same
+ * path kprobes use for their instruction slots - which also does the cache maintenance a
+ * bare store into a fresh executable page would need.  All four words go in as one patch,
+ * so a stub is never reachable half-written.
+ */
+static int ksu_rkp_fill_stub(void *stub, void *fn, void *resume, u32 displaced, u32 landing)
+{
+    void *addrs[4];
+    u32 insns[4];
+    u32 b_resume = ksu_rkp_encode_b((u8 *)stub + 12, resume);
+    unsigned int i;
+
+    if (!b_resume) {
+        pr_err("ksu_samsung_rkp: stub for %pS cannot reach %pS\n", fn, resume);
+        return -ERANGE;
+    }
+
+    memcpy(&insns[0], (u8 *)fn - sizeof(u32), sizeof(insns[0]));
+    insns[1] = landing;
+    insns[2] = displaced;
+    insns[3] = b_resume;
+
+    for (i = 0; i < ARRAY_SIZE(insns); i++)
+        addrs[i] = (u8 *)stub + i * sizeof(u32);
+
+    return ksu_rkp_insn_patch(addrs, insns, ARRAY_SIZE(insns));
+}
+
+static int ksu_rkp_ensure_stub_page(void)
+{
+    int ret;
+
+    if (ksu_rkp_stub_page)
+        return 0;
+
+    ksu_rkp_stub_page = ksu_rkp_alloc(PAGE_SIZE);
+    if (!ksu_rkp_stub_page)
+        return -ENOMEM;
+
+    /* A page that is still writable must not be handed out as code. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 3, 0)
+    ret = set_memory_rox((unsigned long)ksu_rkp_stub_page, 1);
+#else
+    ret = set_memory_ro((unsigned long)ksu_rkp_stub_page, 1);
+    if (!ret)
+        ret = set_memory_x((unsigned long)ksu_rkp_stub_page, 1);
+#endif
+    if (ret) {
+        ksu_rkp_free(ksu_rkp_stub_page);
+        ksu_rkp_stub_page = NULL;
+    }
+
+    return ret;
+}
+
+/*
+ * Hand out a stub slot.
+ *
+ * A slot that a restore handed back may still be executing on another CPU: the callers that took
+ * it through callthru_* keep the address, and one of them can be inside it right now.  Every
+ * reuse therefore drains those callers first - one drain covers every slot freed so far, and the
+ * extra one on a later reuse only costs time on a path that runs at feature-toggle speed.  Without
+ * that primitive nothing is recycled, which brings back the old "page runs out" limit instead of
+ * rewriting a stub under a live caller.
+ *
+ * A slot is consumed as soon as its stub is filled, not when the branch lands: a patch that then
+ * fails leaves the stub describing the original, and because the slot is never handed out again a
+ * caller that already took its address keeps calling the original rather than somebody else's
+ * displaced instruction.
+ */
+static int ksu_rkp_alloc_stub(unsigned int *idx)
+{
+    if (ksu_rkp_stub_free_count && ksu_rkp_drain_callers) {
+        ksu_rkp_drain_callers();
+        *idx = ksu_rkp_stub_free[--ksu_rkp_stub_free_count];
+        return 0;
+    }
+
+    if (ksu_rkp_stub_next >= KSU_RKP_STUBS_PER_PAGE)
+        return -ENOMEM;
+
+    *idx = ksu_rkp_stub_next++;
+    return 0;
+}
+
+/* Give a restored site's slot back.  At most KSU_RKP_MAX_SITES sites exist at once, so this list
+ * cannot overflow.
+ */
+static void ksu_rkp_free_stub(unsigned int idx)
+{
+    if (ksu_rkp_stub_free_count < ARRAY_SIZE(ksu_rkp_stub_free))
+        ksu_rkp_stub_free[ksu_rkp_stub_free_count++] = idx;
+}
+
+/*
+ * Replace the function @dst points at with the function @src points at.
+ *
+ * Both are pointers to function pointers, which is ksu_patch_text()'s shape; reading through
+ * them here is what lets patch_memory.c forward an 8-byte slot write without knowing anything
+ * else about the caller.
+ */
+int ksu_samsung_rkp_branch_patch_callthru(void *dst, void *src, void **callthru)
+{
+    void *fn;
+    void *new_fn;
+    struct ksu_rkp_site *site;
+    void *patch_addr;
+    void *resume;
+    void *stub;
+    u32 fn0_insn;
+    u32 displaced;
+    u32 landing;
+    u32 branch;
+    unsigned int preamble_skip;
+    unsigned int stub_idx;
+    int ret;
+
+    if (!ksu_rkp_active || !dst || !src)
+        return -EOPNOTSUPP;
+
+    fn = *(void **)dst;
+    new_fn = *(void **)src;
+    if (!fn || !new_fn)
+        return -EINVAL;
+
+    mutex_lock(&ksu_rkp_site_lock);
+
+    site = ksu_rkp_find_site(fn);
+    if (site) {
+        unsigned int old_idx = site->stub_idx;
+
+        /* A second request for the same function replaces the first: that is the
+         * re-enable-after-a-failed-disable path.  The caller that already took the old stub keeps
+         * working - that stub still runs the displaced instruction and resumes in the original -
+         * and its slot goes back to the pool for a drained reuse. */
+        ret = ksu_rkp_restore_site(site);
+        if (ret) {
+            mutex_unlock(&ksu_rkp_site_lock);
+            return ret;
+        }
+
+        *site = ksu_rkp_sites[--ksu_rkp_site_count];
+        ksu_rkp_free_stub(old_idx);
+        pr_info("ksu_samsung_rkp: branch site at %pS removed\n", fn);
+        if (new_fn == fn) {
+            mutex_unlock(&ksu_rkp_site_lock);
+            return 0;
+        }
+    }
+
+    if (fn == new_fn) {
+        mutex_unlock(&ksu_rkp_site_lock);
+        return 0;
+    }
+
+    if (ksu_rkp_site_count >= KSU_RKP_MAX_SITES) {
+        mutex_unlock(&ksu_rkp_site_lock);
+        pr_err("ksu_samsung_rkp: branch site table is full\n");
+        return -ENOMEM;
+    }
+
+    ret = ksu_rkp_ensure_stub_page();
+    if (ret) {
+        mutex_unlock(&ksu_rkp_site_lock);
+        pr_err("ksu_samsung_rkp: no executable page for stubs: %d\n", ret);
+        return ret;
+    }
+
+    ret = ksu_rkp_alloc_stub(&stub_idx);
+    if (ret) {
+        mutex_unlock(&ksu_rkp_site_lock);
+        pr_err("ksu_samsung_rkp: no stub slot available: %d\n", ret);
+        return ret;
+    }
+
+    fn0_insn = *(u32 *)fn;
+    displaced = fn0_insn;
+
+    /* Step over the BTI/PAC preamble (at most two instructions) so the branch does not
+     * clobber the landing pad: an indirect call arrives with BLR, and a function whose
+     * fn+0 no longer takes that call raises a BTI violation instead of running.  A PAC is
+     * skippable only at fn+0: the stub replays the displaced instruction, so a PAC reached
+     * later in the preamble (the "bti c; paciasp" layout) has to become that displaced one
+     * - step over it and the stub jumps to fn+8 with LR never signed. */
+    preamble_skip = 0;
+    while (preamble_skip < 2 && ksu_rkp_is_landing_pad(displaced)) {
+        if (preamble_skip > 0 && ksu_rkp_is_pac_signing(displaced))
+            break;
+        preamble_skip++;
+        displaced = *(u32 *)((u8 *)fn + preamble_skip * 4);
+    }
+
+    patch_addr = (u8 *)fn + preamble_skip * 4;
+    resume = (u8 *)fn + (preamble_skip + 1) * 4;
+
+    if (ksu_rkp_is_pc_relative(displaced)) {
+        mutex_unlock(&ksu_rkp_site_lock);
+        pr_err("ksu_samsung_rkp: %pS: instruction at +%u is PC-relative, not installing\n", fn,
+               preamble_skip * 4);
+        return -EINVAL;
+    }
+
+    /* PACIASP/PACIBSP at fn+0 signs LR in place.  Left there, it would sign before the
+     * branch, and a replacement that signs again in its own entry makes AUTXSP fail at its
+     * epilogue - a fatal FPAC exception.  BTI C keeps the landing pad without signing. */
+    landing = KSU_RKP_INSN_BTI_C;
+    if (preamble_skip > 0 && ksu_rkp_is_pac_signing(fn0_insn))
+        landing = fn0_insn;
+
+    branch = ksu_rkp_encode_b(patch_addr, new_fn);
+    if (!branch) {
+        mutex_unlock(&ksu_rkp_site_lock);
+        pr_err("ksu_samsung_rkp: %pS -> %pS is out of branch range\n", fn, new_fn);
+        return -ERANGE;
+    }
+
+    stub = (u8 *)ksu_rkp_stub_page + stub_idx * KSU_RKP_STUB_SIZE;
+    ret = ksu_rkp_fill_stub(stub, fn, resume, displaced, landing);
+    if (ret) {
+        mutex_unlock(&ksu_rkp_site_lock);
+        return ret;
+    }
+
+    /*
+     * Publish the callable entry for the displaced original BEFORE the branch goes live.  A
+     * caller that arrives in between must reach the stub - which runs the instruction the branch
+     * displaced and resumes past it, i.e. the original function - and not the function whose
+     * entry is about to become the branch.  The other order is not a window but a permanent
+     * infinite recursion on whatever path the caller saves its original from, and it is the one
+     * failure this parameter exists to prevent.
+     *
+     * The stub is a valid entry in both states, so a caller that keeps it never has to be told
+     * that the branch write below failed - it just runs the original either way.
+     */
+    if (callthru)
+        WRITE_ONCE(*callthru, (void *)((u8 *)stub + 4));
+
+    /* fn+0 and the branch go in together: a CPU that saw one without the other would either
+     * lose the landing pad or branch from a signed frame. */
+    if (landing == fn0_insn && fn0_insn) {
+        void *addrs[2] = { fn, patch_addr };
+        u32 insns[2] = { KSU_RKP_INSN_BTI_C, branch };
+
+        ret = ksu_rkp_insn_patch(addrs, insns, 2);
+    } else {
+        ret = ksu_rkp_insn_patch(&patch_addr, &branch, 1);
+    }
+
+    if (ret) {
+        mutex_unlock(&ksu_rkp_site_lock);
+        pr_err("ksu_samsung_rkp: patching %pS failed: %d\n", fn, ret);
+        return ret;
+    }
+
+    ksu_rkp_sites[ksu_rkp_site_count].fn = fn;
+    ksu_rkp_sites[ksu_rkp_site_count].insn_at_patch = displaced;
+    ksu_rkp_sites[ksu_rkp_site_count].insn_at_fn0 = (landing == fn0_insn && fn0_insn) ? fn0_insn : 0;
+    ksu_rkp_sites[ksu_rkp_site_count].stub_idx = stub_idx;
+    ksu_rkp_sites[ksu_rkp_site_count].preamble_skip = preamble_skip;
+    ksu_rkp_site_count++;
+
+    pr_info("ksu_samsung_rkp: %pS -> %pS (stub %u)\n", fn, new_fn,
+            ksu_rkp_sites[ksu_rkp_site_count - 1].stub_idx);
+
+    mutex_unlock(&ksu_rkp_site_lock);
+    return 0;
+}
+
+int ksu_samsung_rkp_branch_patch(void *dst, void *src)
+{
+    return ksu_samsung_rkp_branch_patch_callthru(dst, src, NULL);
+}
+
+void *ksu_samsung_rkp_get_stub(void *fn)
+{
+    struct ksu_rkp_site *site;
+    void *stub = NULL;
+
+    if (!ksu_rkp_active || !fn)
+        return NULL;
+
+    mutex_lock(&ksu_rkp_site_lock);
+    site = ksu_rkp_find_site(fn);
+    if (site && ksu_rkp_stub_page)
+        stub = (u8 *)ksu_rkp_stub_page + site->stub_idx * KSU_RKP_STUB_SIZE + 4;
+    mutex_unlock(&ksu_rkp_site_lock);
+
+    return stub;
+}
+
+void ksu_samsung_rkp_init(void)
+{
+    ksu_rkp_insn_patch = (ksu_rkp_insn_patch_t)ksu_resolve_symbol_for_functable_hook("aarch64_insn_patch_text");
+
+    if (!ksu_rkp_insn_patch) {
+        pr_info("ksu_samsung_rkp: instruction patching is not reachable, staying off\n");
+        return;
+    }
+
+    /* RKP is the reason the direct route is unavailable; without it the plain route is both
+     * cheaper and better tested, so the branch route stays off. */
+    if (!ksu_resolve_symbol_for_functable_hook("rkp_started")) {
+        pr_info("ksu_samsung_rkp: no RKP on this kernel, the direct route is used\n");
+        return;
+    }
+
+    ksu_rkp_drain_callers = (void *)ksu_resolve_symbol_for_functable_hook("synchronize_rcu_tasks");
+    if (!ksu_rkp_drain_callers)
+        pr_info("ksu_samsung_rkp: synchronize_rcu_tasks not reachable, stub slots are not recycled\n");
+
+    ksu_rkp_active = true;
+    pr_info("ksu_samsung_rkp: RKP detected, function slots are served by branch patching\n");
+}
+
+void ksu_samsung_rkp_exit(void)
+{
+    struct ksu_rkp_site *site;
+    bool restored = true;
+
+    mutex_lock(&ksu_rkp_site_lock);
+
+    while (ksu_rkp_site_count > 0) {
+        site = &ksu_rkp_sites[ksu_rkp_site_count - 1];
+        if (ksu_rkp_restore_site(site)) {
+            pr_warn("ksu_samsung_rkp: %pS keeps its branch\n", site->fn);
+            restored = false;
+        }
+        ksu_rkp_site_count--;
+    }
+
+    if (ksu_rkp_stub_page && restored) {
+        if (!ksu_rkp_drain_callers) {
+            /* A caller that already read a callthru_* pointer can still be inside its stub, and
+             * without the drain there is no way to know it has left.  Leaking one page beats
+             * executing freed memory. */
+            pr_err("ksu_samsung_rkp: no caller drain available, keeping the stub page\n");
+        } else {
+            ksu_rkp_drain_callers();
+            (void)set_memory_nx((unsigned long)ksu_rkp_stub_page, 1);
+            ksu_rkp_free(ksu_rkp_stub_page);
+            ksu_rkp_stub_page = NULL;
+            ksu_rkp_stub_next = 0;
+            ksu_rkp_stub_free_count = 0;
+        }
+    } else if (ksu_rkp_stub_page) {
+        /* A branch that is still installed reaches into the stub page, so the page has to
+         * outlive the module in that case; the alternative is a jump into freed memory. */
+        pr_err("ksu_samsung_rkp: a branch is still installed, keeping the stub page\n");
+    }
+
+    ksu_rkp_active = false;
+    mutex_unlock(&ksu_rkp_site_lock);
+}
+
+#else /* !__aarch64__ */
+
+bool ksu_samsung_rkp_active(void)
+{
+    return false;
+}
+
+int ksu_samsung_rkp_branch_patch(void *dst, void *src)
+{
+    return -EOPNOTSUPP;
+}
+
+int ksu_samsung_rkp_branch_patch_callthru(void *dst, void *src, void **callthru)
+{
+    return -EOPNOTSUPP;
+}
+
+void *ksu_samsung_rkp_get_stub(void *fn)
+{
+    return NULL;
+}
+
+void ksu_samsung_rkp_init(void)
+{
+}
+
+void ksu_samsung_rkp_exit(void)
+{
+}
+
+#endif /* __aarch64__ */
