+/*
+ * RKP takes kernel text and rodata away from the kernel, so the text-patching
+ * route below cannot be used on these targets. KSU_SAMSUNG_NO_PATCH_TEXT turns
+ * the route off explicitly; KSU_SAMSUNG_RKP implies the same protection. Both
+ * need kprobes to stand in for the patched table entries: without CONFIG_KPROBES
+ * the register_kprobe() stubs only ever return -ENOSYS, so let the text route
+ * stay compiled and report why it cannot patch instead.
+ */
+#if (defined(CONFIG_KSU_SAMSUNG_RKP) || defined(CONFIG_KSU_SAMSUNG_NO_PATCH_TEXT)) && defined(CONFIG_KPROBES)
+#define KSU_SAMSUNG_SELINUX_HIDE_USE_KPROBE 1
+#include <linux/hashtable.h>
+#include <linux/kprobes.h>
+#include <linux/spinlock.h>
+#endif
 // security/selinux/include/security.h
 #include <security.h>
 #include <ss/context.h>
@@ -318,6 +332,243 @@ static int my_sel_open_handle_status(struct inode *inode, struct file *filp)
     return ret;
 }
 
+#ifdef KSU_SAMSUNG_SELINUX_HIDE_USE_KPROBE
+/*
+ * Samsung KDP/RKP devices hand kernel text and rodata to the hypervisor, so
+ * ksu_patch_text() cannot be used here: every slot this feature writes
+ * (sel_handle_status_ops, write_op and the LSM hook tables) is protected.
+ * Probe the original handlers with kprobes instead and divert the trapped
+ * instruction pointer from the pre-handler. arm64 kprobes support that: when a
+ * pre-handler returns non-zero the breakpoint handler resets the current probe
+ * and skips the single-step, so the pc we set is what resumes.
+ *
+ * This route leaves exactly one artifact behind: the registered probes.
+ * sel_hide_destroy_kprobes() removes them all, which restores the original
+ * behaviour; nothing has to be written back, because the probed functions are
+ * still live in the kernel image.
+ *
+ * Re-entry: the replacements call the probed originals, so a nested hit on the
+ * same probe has to fall through untouched. The context and access entries are
+ * diverted only for uids in the app range, where the replacement never calls
+ * the original back, so they need no guard at all. status and setprocattr do
+ * call it back, so their wrappers record the current task in a hash table for
+ * the duration of that call. The entry is a stack local, so a pre-handler
+ * allocates nothing and no entry can be left behind for a later task to trip
+ * over.
+ */
+#define KSU_SELINUX_BYPASS_BITS 4
+
+struct sel_hide_bypass {
+    struct hlist_node node;
+    struct task_struct *task;
+};
+
+static DEFINE_HASHTABLE(sel_hide_bypass_tasks, KSU_SELINUX_BYPASS_BITS);
+static DEFINE_SPINLOCK(sel_hide_bypass_lock);
+
+static bool sel_hide_is_bypassed(void)
+{
+    struct sel_hide_bypass *entry;
+    unsigned long flags;
+    bool found = false;
+
+    spin_lock_irqsave(&sel_hide_bypass_lock, flags);
+    hash_for_each_possible(sel_hide_bypass_tasks, entry, node, (unsigned long)current) {
+        if (entry->task == current) {
+            found = true;
+            break;
+        }
+    }
+    spin_unlock_irqrestore(&sel_hide_bypass_lock, flags);
+    return found;
+}
+
+// Divert targets that call the probed original back: the task is recorded only
+// for the window in which that nested call can happen.
+static int sel_hide_status_open_bypass(struct inode *inode, struct file *filp)
+{
+    struct sel_hide_bypass bypass = { .task = current };
+    unsigned long flags;
+    int ret;
+
+    spin_lock_irqsave(&sel_hide_bypass_lock, flags);
+    hash_add(sel_hide_bypass_tasks, &bypass.node, (unsigned long)current);
+    spin_unlock_irqrestore(&sel_hide_bypass_lock, flags);
+
+    ret = my_sel_open_handle_status(inode, filp);
+
+    spin_lock_irqsave(&sel_hide_bypass_lock, flags);
+    hash_del(&bypass.node);
+    spin_unlock_irqrestore(&sel_hide_bypass_lock, flags);
+    return ret;
+}
+
+static int sel_hide_setprocattr_bypass(const char *name, void *value, size_t size)
+{
+    struct sel_hide_bypass bypass = { .task = current };
+    unsigned long flags;
+    int ret;
+
+    spin_lock_irqsave(&sel_hide_bypass_lock, flags);
+    hash_add(sel_hide_bypass_tasks, &bypass.node, (unsigned long)current);
+    spin_unlock_irqrestore(&sel_hide_bypass_lock, flags);
+
+    ret = my_setprocattr(name, value, size);
+
+    spin_lock_irqsave(&sel_hide_bypass_lock, flags);
+    hash_del(&bypass.node);
+    spin_unlock_irqrestore(&sel_hide_bypass_lock, flags);
+    return ret;
+}
+
+// Divert only when my_sel_open_handle_status() would do more than call the
+// original: the lazy fake status initialization is still pending, or the
+// feature is enabled with the fake page in place. Any other call falls through
+// to the probed original, exactly like the replacement would.
+//
+// The bypass check is last so the common open (a uid outside the app range, or
+// the feature off) does not take the lock; it still stops the replacement's own
+// call back into the original.
+static int sel_hide_status_open_pre(struct kprobe *p, struct pt_regs *regs)
+{
+    if (!static_branch_unlikely(&fake_status_initialize_key) &&
+        (likely(current_uid().val < 10000) || !ksu_selinux_hide_enabled || !READ_ONCE(fake_status)))
+        return 0;
+    if (sel_hide_is_bypassed())
+        return 0;
+    instruction_pointer_set(regs, (unsigned long)sel_hide_status_open_bypass);
+    return 1;
+}
+
+/*
+ * Policy writes from uids outside the app range are passed through verbatim by
+ * the replacements, so let the probed original run and divert only for apps.
+ * The feature check also keeps a disabled feature away from a replacement that
+ * needs backup_sepolicy, which is dropped while the feature is off.
+ */
+static int sel_hide_context_write_pre(struct kprobe *p, struct pt_regs *regs)
+{
+    if (!ksu_selinux_hide_enabled || likely(current_uid().val < 10000))
+        return 0;
+    instruction_pointer_set(regs, (unsigned long)my_write_context);
+    return 1;
+}
+
+static int sel_hide_access_write_pre(struct kprobe *p, struct pt_regs *regs)
+{
+    /* Same reasoning as sel_hide_context_write_pre(). */
+    if (!ksu_selinux_hide_enabled || likely(current_uid().val < 10000))
+        return 0;
+    instruction_pointer_set(regs, (unsigned long)my_write_access);
+    return 1;
+}
+
+static int sel_hide_setprocattr_pre(struct kprobe *p, struct pt_regs *regs)
+{
+    /* Same reasoning as sel_hide_context_write_pre(). */
+    if (!ksu_selinux_hide_enabled || likely(current_uid().val < 10000) || sel_hide_is_bypassed())
+        return 0;
+    instruction_pointer_set(regs, (unsigned long)sel_hide_setprocattr_bypass);
+    return 1;
+}
+
+/*
+ * Registered probes. NULL means "not installed", the same role
+ * orig_sel_open_handle_status plays for the status hook in the text-patching
+ * build.
+ */
+static struct kprobe *sel_hide_context_write_kp;
+static struct kprobe *sel_hide_access_write_kp;
+static struct kprobe *sel_hide_setprocattr_kp;
+static struct kprobe *sel_hide_status_open_kp;
+
+/*
+ * Register a probe on @target, mirroring init_kprobe() in kernel/extras.c: a
+ * fresh struct per registration, NULL on failure. The difference is that these
+ * probes are address-based instead of symbol-based, because the targets are
+ * read out of the slots at runtime (write_op entries, the sel_handle_status_ops
+ * open pointer and selinux_setprocattr). register_kprobe() handles an explicit
+ * address through the same path as a resolved symbol name.
+ */
+static struct kprobe *sel_hide_init_kprobe(const char *name, void *target, kprobe_pre_handler_t handler, int *err)
+{
+    struct kprobe *kp;
+    int ret;
+
+    if (!target) {
+        pr_err("selinux_hide: %s has no target, skipping probe\n", name);
+        *err = -ENOENT;
+        return NULL;
+    }
+
+    kp = kzalloc(sizeof(*kp), GFP_KERNEL);
+    if (!kp) {
+        pr_err("selinux_hide: no memory for the %s probe\n", name);
+        *err = -ENOMEM;
+        return NULL;
+    }
+
+    kp->addr = (kprobe_opcode_t *)target;
+    kp->pre_handler = handler;
+
+    ret = register_kprobe(kp);
+    pr_info("selinux_hide: register_%s kprobe: 0x%lx: %d\n", name, (unsigned long)target, ret);
+    if (ret) {
+        kfree(kp);
+        *err = ret;
+        return NULL;
+    }
+
+    *err = 0;
+    return kp;
+}
+
+// Mirror of destroy_kprobe() in kernel/extras.c.
+static void sel_hide_destroy_kprobe(struct kprobe **kp_ptr)
+{
+    struct kprobe *kp = *kp_ptr;
+
+    if (!kp)
+        return;
+    unregister_kprobe(kp);
+    synchronize_rcu();
+    kfree(kp);
+    *kp_ptr = NULL;
+}
+
+// Idempotent, so it serves both as the enable() rollback and as the full
+// unhook.
+static void sel_hide_destroy_kprobes()
+{
+    sel_hide_destroy_kprobe(&sel_hide_context_write_kp);
+    sel_hide_destroy_kprobe(&sel_hide_access_write_kp);
+    sel_hide_destroy_kprobe(&sel_hide_setprocattr_kp);
+    sel_hide_destroy_kprobe(&sel_hide_status_open_kp);
+}
+
+// Installs the three probes this feature owns while it is enabled. On failure
+// the caller rolls back with sel_hide_destroy_kprobes(), which skips the probes
+// that were never installed.
+static int sel_hide_init_enable_probes(void)
+{
+    int err;
+
+    sel_hide_context_write_kp =
+        sel_hide_init_kprobe("context_write", orig_context_write, sel_hide_context_write_pre, &err);
+    if (!sel_hide_context_write_kp)
+        return err;
+
+    sel_hide_access_write_kp =
+        sel_hide_init_kprobe("access_write", orig_access_write, sel_hide_access_write_pre, &err);
+    if (!sel_hide_access_write_kp)
+        return err;
+
+    sel_hide_setprocattr_kp = sel_hide_init_kprobe("selinux_setprocattr", selinux_setprocattr_hook.original,
+                                                   sel_hide_setprocattr_pre, &err);
+    return sel_hide_setprocattr_kp ? 0 : err;
+}
+
+#endif
 static void hook_selinux_status_open();
 static void ksu_selinux_hide_unhook();
 static int ksu_selinux_hide_enable()
